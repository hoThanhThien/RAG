# ==============================================================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG CHO RAG TOUR BOOKING (BE + FE + DOCKER)
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép file này thành .env:
#    cp .env.example .env   (hoặc copy .env.example .env trên Windows)
# 2. Chỉnh sửa các giá trị phù hợp với môi trường (Local hoặc VPS / Domain).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PORTS MẶC ĐỊNH CHO CÁC SERVICES
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH FRONTEND (Vite SPA)
# ------------------------------------------------------------------------------
# Khi chạy Local:
#   VITE_API_URL=http://localhost:8000
#   VITE_WS_URL=ws://localhost:8000
#
# Khi Deploy VPS có IP công khai (VD: 103.20.10.5):
#   VITE_API_URL=http://103.20.10.5:8000
#   VITE_WS_URL=ws://103.20.10.5:8000
#
# Khi Deploy có Domain và SSL/HTTPS (VD: mytour.com):
#   VITE_API_URL=https://api.mytour.com
#   VITE_WS_URL=wss://api.mytour.com
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Thông tin thanh toán hiển thị trên giao diện người dùng
VITE_BANK_CODE=970422
VITE_BANK_NAME="MB Bank"
VITE_BANK_ACCOUNT=0375227764
VITE_BANK_HOLDER="HO THANH THIEN"
VITE_APP_NAME=NHom09
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH BACKEND & JWT & BẢO MẬT (FastAPI)
# ------------------------------------------------------------------------------
# Tạo một secret key ngẫu nhiên an toàn trên production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-jwt-key-for-tour-booking-dev-environment-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URL của Frontend dùng để config CORS và Redirect
# Khi deploy VPS / Domain: Đổi thành URL frontend của bạn (VD: http://103.20.10.5:3000 hoặc https://mytour.com)
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. DATABASE (MySQL 8.0)
# ------------------------------------------------------------------------------
# Chuỗi kết nối từ container backend tới container mysql trong mạng Docker
DATABASE_URL=mysql+pymysql://tour_user:tour_pass123@mysql:3306/tourbookingdb
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=tourbookingdb
MYSQL_USER=tour_user
MYSQL_PASSWORD=tour_pass123

# ------------------------------------------------------------------------------
# 5. REDIS CACHE
# ------------------------------------------------------------------------------
RAG_REDIS_ENABLED=true
RAG_REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 6. CỔNG THANH TOÁN (PayPal, MoMo, SePay / Bank Transfer)
# ------------------------------------------------------------------------------
# PayPal (sandbox hoặc live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# MoMo
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_REDIRECT_URL=http://localhost:3000/payment/success
MOMO_IPN_URL=http://localhost:8000/payments/momo/ipn
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_ENVIRONMENT=test

# SePay / Bank Webhook
BANK_WEBHOOK_URL=http://localhost:8000/payments/webhook/bank
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_ACCOUNT_NUMBER=0375227764

# ------------------------------------------------------------------------------
# 7. AI & RAG RETRIEVAL (OpenAI & Vector DB)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_ANSWER_MAX_TOKENS=320
