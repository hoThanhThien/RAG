# ==========================================
# Tour Booking & RAG System - Backend Config (.env.example)
# ==========================================

DATABASE_URL=mysql+pymysql://tour_user:tour_pass123@localhost:3306/tourbookingdb
SECRET_KEY=your_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_BASE_URL=http://localhost:3000

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# MoMo
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_REDIRECT_URL=http://localhost:3000/payment/success
MOMO_IPN_URL=http://localhost:8000/payments/momo/ipn
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_ENVIRONMENT=test

# Banking Webhook & SePay
BANK_WEBHOOK_URL=http://localhost:8000/payments/webhook/bank
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_ACCOUNT_NUMBER=your_bank_account_number

# OpenAI & RAG
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_ANSWER_MAX_TOKENS=320

RAG_REDIS_ENABLED=false
RAG_REDIS_URL=redis://localhost:6379/0
